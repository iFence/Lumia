        </InstallExecuteSequence>
        <InstallUISequence>
            <Custom Action="SetAPPLICATIONFOLDER" After="AppSearch">LASTINSTALLDIR</Custom>
            <Custom Action="SetARPINSTALLLOCATION" After="CostFinalize" />
            <Custom Action="SetINSTALLDESKTOPSHORTCUT" After="SetARPINSTALLLOCATION">&amp;DesktopShortcutFeature=3</Custom>

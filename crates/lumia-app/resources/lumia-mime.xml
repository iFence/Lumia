<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/x-dds">
    <comment>DirectDraw Surface image</comment>
    <glob pattern="*.dds"/>
  </mime-type>
  <mime-type type="image/x-exr">
    <comment>OpenEXR image</comment>
    <glob pattern="*.exr"/>
  </mime-type>
  <mime-type type="image/x-farbfeld">
    <comment>Farbfeld image</comment>
    <glob pattern="*.ff"/>
    <glob pattern="*.farbfeld"/>
  </mime-type>
  <mime-type type="image/x-qoi">
    <comment>Quite OK Image</comment>
    <glob pattern="*.qoi"/>
  </mime-type>
  <mime-type type="image/x-tga">
    <comment>Truevision TGA image</comment>
    <glob pattern="*.tga"/>
  </mime-type>
  <mime-type type="image/vnd.adobe.photoshop">
    <comment>Adobe Photoshop document</comment>
    <glob pattern="*.psd"/>
    <glob pattern="*.psb"/>
  </mime-type>
  <mime-type type="image/x-camera-raw">
    <comment>Camera RAW image</comment>
    <glob pattern="*.dng"/><glob pattern="*.cr2"/><glob pattern="*.cr3"/>
    <glob pattern="*.crw"/><glob pattern="*.nef"/><glob pattern="*.nrw"/>
    <glob pattern="*.arw"/><glob pattern="*.sr2"/><glob pattern="*.srf"/>
    <glob pattern="*.raf"/><glob pattern="*.orf"/><glob pattern="*.rw2"/>
    <glob pattern="*.rwl"/><glob pattern="*.pef"/><glob pattern="*.srw"/>
    <glob pattern="*.3fr"/><glob pattern="*.fff"/><glob pattern="*.mef"/>
    <glob pattern="*.mos"/><glob pattern="*.mrw"/><glob pattern="*.kdc"/>
    <glob pattern="*.dcr"/><glob pattern="*.erf"/><glob pattern="*.x3f"/>
    <glob pattern="*.iiq"/>
  </mime-type>
</mime-info>

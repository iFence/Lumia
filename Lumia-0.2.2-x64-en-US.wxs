        <UIRef Id="WixUI_InstallDir" />
        <Upgrade Id="{07618386-59AC-4B5C-B4E1-EBE4F8AA182E}">
            <UpgradeVersion Minimum="0.2.2" Property="LUMIA_NEWER_VERSION_DETECTED" OnlyDetect="yes" />
            <UpgradeVersion Minimum="0.0.0" Maximum="0.2.2" Property="LUMIA_UPGRADE_DETECTED" MigrateFeatures="yes" IncludeMinimum="yes" IncludeMaximum="yes" />
        </Upgrade>
        <InstallExecuteSequence>

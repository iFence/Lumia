{
  "id": "lumia.annotation",
  "name": "Lumia Annotation",
  "version": "0.2.0",
  "entry": "lumia-plugin-annotation",
  "capabilities": ["ui_contributions", "canvas_overlay"],
  "permissions": [],
  "supported_inputs": [],
  "supported_outputs": ["image/png", "image/jpeg", "image/webp"],
  "contributions": {
    "commands": [
      {
        "id": "annotation.open",
        "label": {
          "fallback": "Annotate",
          "translations": { "zh-CN": "标注" }
        },
        "icon": { "type": "annotation" },
        "requires_document": true
      }
    ],
    "viewer_context_menu": [
      {
        "id": "annotation.context_menu",
        "command_id": "annotation.open",
        "group": 10,
        "order": 10
      }
    ],
    "right_panels": [
      {
        "id": "annotation.panel",
        "command_id": "annotation.open",
        "title": {
          "fallback": "Annotation",
          "translations": { "zh-CN": "标注" }
        }
      }
    ],
    "canvas_tools": [
      {
        "id": "annotation.text",
        "label": {
          "fallback": "Text",
          "translations": { "zh-CN": "文字" }
        },
        "icon": { "type": "text" },
        "kind": "text"
      },
      {
        "id": "annotation.rectangle",
        "label": {
          "fallback": "Rectangle",
          "translations": { "zh-CN": "矩形框" }
        },
        "icon": { "type": "rectangle" },
        "kind": "rectangle"
      },
      {
        "id": "annotation.numbered_step",
        "label": {
          "fallback": "Numbered step",
          "translations": { "zh-CN": "数字步骤" }
        },
        "icon": { "type": "numbered_step" },
        "kind": "numbered_step"
      }
    ]
  },
  "assets": []
}

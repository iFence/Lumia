        <UI>
            <Dialog Id="InstallOptionsDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="35" Y="105" Width="300" Height="18" Property="INSTALLDESKTOPSHORTCUT" Text="Create a desktop shortcut" CheckBoxValue="1" TabSkip="no" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" TabSkip="no">
                    <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Next" TabSkip="no" Default="yes">
                    <Publish Event="AddLocal" Value="DesktopShortcutFeature">INSTALLDESKTOPSHORTCUT="1"</Publish>
                    <Publish Event="Remove" Value="DesktopShortcutFeature">INSTALLDESKTOPSHORTCUT&lt;&gt;"1"</Publish>
                    <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" TabSkip="no" Cancel="yes">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
                <Control Id="Description" Type="Text" X="25" Y="55" Width="320" Height="30" Text="Choose the shortcuts you want Setup to create. A Start menu shortcut is always installed." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="Title" Type="Text" X="25" Y="25" Width="320" Height="20" Text="Installation options" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" TabSkip="yes" Disabled="yes" />
            </Dialog>
